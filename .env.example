# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server only, never expose to the browser
SUPABASE_SECRET_KEY=

# The host (Anthropic Messages API)
ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-5
HOST_MODEL=

# Shared secret for GET /api/cron/weekly (Authorization: Bearer ...)
CRON_SECRET=

# Origin used for magic-link redirects, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=
